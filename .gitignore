# Dependencies & Vendors
/backend/vendor/
/frontend/node_modules/
/frontend/dist/

# Environment files
/backend/.env
/backend/.env.backup
/backend/.env.production
/frontend/.env.local
/frontend/.env.*.local

# Storage & Cache
/backend/storage/*.key
/backend/storage/app/temp_uploads/
/backend/storage/logs/*.log
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/bootstrap/cache/*.php

# SQLite DB
/backend/database/database.sqlite
/backend/database/database.sqlite-journal

# Logs & OS Files
*.log
.DS_Store
.idea/
.vscode/
